{
  "name": "orbio-guard",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first credit controls for Orbio-powered AI agents.",
  "type": "module",
  "bin": {
    "orbio-guard": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:ui": "npm run build && node tests/e2e/dashboard-render.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "commander": "15.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "latest",
    "playwright": "^1.63.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
